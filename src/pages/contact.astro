---
import BaseLayout from '../layouts/BaseLayout.astro';
import { author } from '../data/author';
---

<BaseLayout
  title="Contact & Error Corrections | Cover & Capital India"
  description="Contact author Chirag Singhal to report errors, submit statutory corrections, or propose research topics on Indian life insurance and taxation."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="space-y-8">
      <div class="border-b border-[#E5E3D8] pb-6">
        <span class="text-xs font-semibold uppercase tracking-wider text-[#0D5C46]">Get In Touch</span>
        <h1 class="text-3xl sm:text-4xl font-bold font-serif text-[#0F172A] mt-2">
          Contact & Corrections Policy
        </h1>
        <p class="text-base text-[#475569] mt-3 leading-relaxed">
          Cover & Capital India is an independently maintained publication. We welcome feedback, mathematical audits, and statutory corrections from readers, actuaries, and financial researchers.
        </p>
      </div>

      <div class="bg-white border border-[#E5E3D8] rounded-xl p-6 sm:p-8 space-y-6">
        <div>
          <h2 class="text-xl font-bold font-serif text-[#0F172A]">Direct Contact Details</h2>
          <p class="text-sm text-[#475569] mt-1">
            Author & Research Lead: <strong>{author.name}</strong>
          </p>
        </div>

        <div class="space-y-3 text-sm text-[#334155]">
          <div class="flex items-center gap-3">
            <span class="font-semibold text-[#0F172A] w-24">Public Email:</span>
            <a href={`mailto:${author.contactEmail}`} class="text-[#0D5C46] font-semibold hover:underline">
              {author.contactEmail}
            </a>
          </div>
          <div class="flex items-center gap-3">
            <span class="font-semibold text-[#0F172A] w-24">GitHub:</span>
            <a href={author.socials.github} target="_blank" rel="noopener noreferrer" class="text-[#0D5C46] hover:underline">
              {author.socials.github}
            </a>
          </div>
          <div class="flex items-center gap-3">
            <span class="font-semibold text-[#0F172A] w-24">LinkedIn:</span>
            <a href={author.socials.linkedin} target="_blank" rel="noopener noreferrer" class="text-[#0D5C46] hover:underline">
              {author.socials.linkedin}
            </a>
          </div>
          <div class="flex items-center gap-3">
            <span class="font-semibold text-[#0F172A] w-24">Location:</span>
            <span>India</span>
          </div>
        </div>

        <div class="border-t border-[#E5E3D8] pt-6 space-y-3">
          <h3 class="text-base font-bold text-[#0F172A]">Reporting an Inaccuracy or Outdated Source</h3>
          <p class="text-xs sm:text-sm text-[#475569] leading-relaxed">
            If you notice a newly issued IRDAI circular, a CBDT notification affecting insurance taxation, or an arithmetic discrepancy in our calculator models, please email <a href={`mailto:${author.contactEmail}`} class="text-[#0D5C46] font-medium">{author.contactEmail}</a> with:
          </p>
          <ul class="text-xs text-[#475569] list-disc pl-5 space-y-1">
            <li>The article or calculator URL.</li>
            <li>The specific passage or equation in question.</li>
            <li>A link or reference to the primary official source (Gazette, CBDT, IRDAI, or policy bond).</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
