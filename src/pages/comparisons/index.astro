---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const comparisonArticles = await getCollection('articles', ({ data }) => !data.draft && data.category === 'comparisons');
---

<BaseLayout
  title="Comparison Centre | Insurance vs Mutual Funds, PPF & FDs"
  description="Honest numerical comparisons between insurance products and direct investment strategies. Term + Mutual Funds vs ULIPs, Guaranteed Plans vs PPF, and Annuity vs SWP."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="border-b border-[#E5E3D8] pb-8 mb-12">
      <span class="text-xs font-semibold uppercase tracking-wider text-[#0D5C46]">Analytical Comparisons</span>
      <h1 class="text-3xl sm:text-4xl font-bold font-serif text-[#0F172A] mt-2">
        Comparison Centre: Insurance vs Alternatives
      </h1>
      <p class="text-base text-[#475569] mt-3 max-w-3xl leading-relaxed">
        We compare insurance contracts against direct mutual funds, Public Provident Fund (PPF), bank deposits, and government bonds by holding cash flows and life protection equal.
      </p>
    </div>

    <!-- Master Comparative Table -->
    <div class="bg-white border border-[#E5E3D8] rounded-xl p-6 sm:p-8 mb-12 shadow-2xs">
      <h2 class="text-xl font-bold font-serif text-[#0F172A] mb-4">
        Strategy Comparison Overview
      </h2>
      <div class="overflow-x-auto text-xs sm:text-sm">
        <table class="w-full border-collapse border border-[#E5E3D8]">
          <thead>
            <tr class="bg-[#F1EFEA] text-[#0F172A]">
              <th class="p-3 text-left border border-[#D1CEBE]">Strategy</th>
              <th class="p-3 text-left border border-[#D1CEBE]">Primary Purpose</th>
              <th class="p-3 text-left border border-[#D1CEBE]">Typical Post-Tax Yield</th>
              <th class="p-3 text-left border border-[#D1CEBE]">Liquidity</th>
              <th class="p-3 text-left border border-[#D1CEBE]">Life Cover</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-[#E5E3D8]">
              <td class="p-3 font-semibold text-[#0F172A]">Pure Term + Direct Index SIP</td>
              <td class="p-3">Unbundled Protection + Wealth Compounding</td>
              <td class="p-3 text-[#166534] font-semibold">10.5%–11.5% Net</td>
              <td class="p-3 text-[#166534]">High (T+2 Days)</td>
              <td class="p-3 font-semibold text-[#166534]">₹1 Cr to ₹3 Cr</td>
            </tr>
            <tr class="border-b border-[#E5E3D8] bg-[#FAF9F5]">
              <td class="p-3 font-semibold text-[#0F172A]">Online Unit-Linked Plan (ULIP)</td>
              <td class="p-3">Bundled Market Investment</td>
              <td class="p-3 font-semibold text-[#334155]">9.5%–10.5% Net</td>
              <td class="p-3 text-[#B91C1C]">Zero for 5 Years</td>
              <td class="p-3 text-[#B91C1C]">₹10 Lakh to ₹15 Lakh</td>
            </tr>
            <tr class="border-b border-[#E5E3D8]">
              <td class="p-3 font-semibold text-[#0F172A]">Guaranteed Income / Endowment</td>
              <td class="p-3">Guaranteed Nominal Cash Flows</td>
              <td class="p-3 font-semibold text-[#92400E]">5.0%–5.8% IRR</td>
              <td class="p-3 text-[#B91C1C]">Very Low (Heavy exit loss)</td>
              <td class="p-3 text-[#B91C1C]">₹10 Lakh to ₹15 Lakh</td>
            </tr>
            <tr class="border-b border-[#E5E3D8] bg-[#FAF9F5]">
              <td class="p-3 font-semibold text-[#0F172A]">Public Provident Fund (PPF)</td>
              <td class="p-3">Sovereign Debt Savings (EEE)</td>
              <td class="p-3 font-semibold text-[#166534]">7.10% (Tax-Free)</td>
              <td class="p-3">Partial after 7 yrs</td>
              <td class="p-3 text-[#64748B]">None (Pure investment)</td>
            </tr>
            <tr>
              <td class="p-3 font-semibold text-[#0F172A]">Bank Fixed Deposit (FD)</td>
              <td class="p-3">Short-to-Medium Term Liquidity</td>
              <td class="p-3 font-semibold text-[#475569]">4.5%–5.5% Post-Tax</td>
              <td class="p-3 text-[#166534]">Instant</td>
              <td class="p-3 text-[#64748B]">None (Pure investment)</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Comparison Guides Grid -->
    <div>
      <h2 class="text-xl font-bold font-serif text-[#0F172A] mb-6">In-Depth Comparison Research</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {comparisonArticles.map((art) => (
          <article class="bg-white border border-[#E5E3D8] rounded-xl p-6 flex flex-col justify-between hover:border-[#0D5C46] transition-colors">
            <div class="space-y-3">
              <span class="text-[11px] font-semibold uppercase px-2 py-0.5 rounded bg-[#E6F3EF] text-[#0D5C46]">
                {art.data.subcategory || 'Comparison'}
              </span>
              <h3 class="text-lg font-bold font-serif text-[#0F172A] leading-snug">
                <a href={`/cover-and-capital-india/articles/${art.id}/`} class="hover:text-[#0D5C46]">
                  {art.data.title}
                </a>
              </h3>
              <p class="text-xs text-[#64748B] leading-relaxed line-clamp-3">
                {art.data.description}
              </p>
            </div>
            <div class="pt-4 mt-4 border-t border-[#F1EFEA] flex items-center justify-between text-xs text-[#94A3B8]">
              <span>{art.data.readingTime} min read</span>
              <a href={`/cover-and-capital-india/articles/${art.id}/`} class="text-[#0D5C46] font-semibold hover:underline">
                Read Analysis &rarr;
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
