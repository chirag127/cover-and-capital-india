---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const glossaryItems = await getCollection('glossary');
const sortedItems = glossaryItems.sort((a, b) => a.data.term.localeCompare(b.data.term));
---

<BaseLayout
  title="Insurance & Actuarial Glossary | Cover & Capital India"
  description="Plain-English definitions and legal context for Indian insurance, tax, and actuarial terms. Section 45, Beneficial Nominee, Surrender Value, and Reduction in Yield."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="border-b border-[#E5E3D8] pb-8 mb-12">
      <span class="text-xs font-semibold uppercase tracking-wider text-[#0D5C46]">Reference Lexicon</span>
      <h1 class="text-3xl sm:text-4xl font-bold font-serif text-[#0F172A] mt-2">
        Indian Insurance & Actuarial Glossary
      </h1>
      <p class="text-base text-[#475569] mt-3 max-w-3xl leading-relaxed">
        Demystifying complex industry jargon with legal citations, Indian court precedents, and clear plain-English definitions.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {sortedItems.map((item) => (
        <div class="bg-white border border-[#E5E3D8] rounded-xl p-6 space-y-3">
          <div class="flex items-baseline justify-between">
            <h2 class="text-lg font-bold font-serif text-[#0F172A]">{item.data.term}</h2>
            <span class="text-[11px] font-semibold uppercase px-2 py-0.5 rounded bg-[#F1EFEA] text-[#0D5C46]">
              {item.data.category}
            </span>
          </div>
          {item.data.hindiTransliteration && (
            <div class="text-xs text-[#64748B] italic">Hindi: {item.data.hindiTransliteration}</div>
          )}
          <p class="text-sm text-[#334155] leading-relaxed">
            {item.data.plainEnglishSummary}
          </p>
          {item.data.legalOrRegulatoryBasis && (
            <div class="text-xs bg-[#FAF9F5] p-2.5 rounded border border-[#E5E3D8] text-[#475569]">
              <strong class="text-[#0F172A]">Statutory Basis:</strong> {item.data.legalOrRegulatoryBasis}
            </div>
          )}
          {item.data.commonTrapOrConfusion && (
            <div class="text-xs bg-[#FEF2F2] p-2.5 rounded border border-[#FECACA] text-[#991B1B]">
              <strong>Common Confusion:</strong> {item.data.commonTrapOrConfusion}
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
