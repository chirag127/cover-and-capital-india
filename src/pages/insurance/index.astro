---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
---

<BaseLayout
  title="Complete Guide to Life Insurance in India | Knowledge Library"
  description="Explore the complete educational library on Indian life insurance. Pure term plans, ULIPs, guaranteed income plans, riders, underwriting, and claim mechanics."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="border-b border-[#E5E3D8] pb-8 mb-12">
      <span class="text-xs font-semibold uppercase tracking-wider text-[#0D5C46]">Core Subject Library</span>
      <h1 class="text-3xl sm:text-4xl font-bold font-serif text-[#0F172A] mt-2">
        Complete Guide to Life Insurance in India
      </h1>
      <p class="text-base text-[#475569] mt-3 max-w-3xl leading-relaxed">
        An independently authored reference library examining life insurance contracts, statutory underwriting, actuarial pricing, and policyholder rights under IRDAI regulations.
      </p>

      <!-- Topic Sub-Navigation -->
      <div class="flex flex-wrap items-center gap-2 mt-6">
        <a href="/cover-and-capital-india/insurance/term/" class="px-3 py-1.5 rounded-full text-xs font-semibold bg-[#E6F3EF] text-[#0D5C46] hover:bg-[#D1EBE3]">
          Term Insurance
        </a>
        <a href="/cover-and-capital-india/insurance/ulip/" class="px-3 py-1.5 rounded-full text-xs font-semibold bg-[#F1EFEA] text-[#334155] hover:bg-[#E5E3D8]">
          ULIPs
        </a>
        <a href="/cover-and-capital-india/insurance/guaranteed/" class="px-3 py-1.5 rounded-full text-xs font-semibold bg-[#F1EFEA] text-[#334155] hover:bg-[#E5E3D8]">
          Guaranteed Plans
        </a>
        <a href="/cover-and-capital-india/insurance/riders/" class="px-3 py-1.5 rounded-full text-xs font-semibold bg-[#F1EFEA] text-[#334155] hover:bg-[#E5E3D8]">
          Riders & Add-ons
        </a>
        <a href="/cover-and-capital-india/insurance/claims/" class="px-3 py-1.5 rounded-full text-xs font-semibold bg-[#F1EFEA] text-[#334155] hover:bg-[#E5E3D8]">
          Claims & Exclusions
        </a>
        <a href="/cover-and-capital-india/insurance/surrender/" class="px-3 py-1.5 rounded-full text-xs font-semibold bg-[#F1EFEA] text-[#334155] hover:bg-[#E5E3D8]">
          Surrender Decisions
        </a>
      </div>
    </div>

    <!-- Article Directory Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {allArticles.map((art) => (
        <article class="bg-white border border-[#E5E3D8] rounded-xl p-6 flex flex-col justify-between hover:border-[#0D5C46] transition-colors">
          <div class="space-y-3">
            <div class="flex items-center justify-between text-[11px] text-[#64748B]">
              <span class="font-semibold uppercase px-2 py-0.5 rounded bg-[#F1EFEA] text-[#0D5C46]">
                {art.data.category}
              </span>
              <span>{art.data.readingTime} min read</span>
            </div>
            <h2 class="text-base font-bold font-serif text-[#0F172A] leading-snug">
              <a href={`/cover-and-capital-india/articles/${art.id}/`} class="hover:text-[#0D5C46]">
                {art.data.title}
              </a>
            </h2>
            <p class="text-xs text-[#64748B] leading-relaxed line-clamp-3">
              {art.data.description}
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-[#F1EFEA] flex items-center justify-between text-xs text-[#94A3B8]">
            <span>Reviewed: {art.data.reviewedAt || art.data.publishedAt}</span>
            <a
              href={`/cover-and-capital-india/articles/${art.id}/`}
              class="text-[#0D5C46] font-semibold hover:underline"
            >
              Read Guide &rarr;
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
