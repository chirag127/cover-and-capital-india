---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const ulipArticles = await getCollection('articles', ({ data }) => !data.draft && (data.category === 'ulip' || data.tags.includes('ulip')));
---

<BaseLayout
  title="ULIPs Explained | Charges, NAV, Fund Mechanics & ₹2.5L Tax Limits"
  description="In-depth guides on Unit-Linked Insurance Plans (ULIPs). Deconstructs Fund Management Charges, mortality deductions, 5-year lock-in, and the ₹2.5 Lakh statutory tax cap."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="border-b border-[#E5E3D8] pb-8 mb-12">
      <nav class="text-xs text-[#64748B] mb-4">
        <a href="/cover-and-capital-india/" class="hover:text-[#0D5C46]">Home</a> &gt; 
        <a href="/cover-and-capital-india/insurance/" class="hover:text-[#0D5C46]">Insurance</a> &gt; 
        <span class="text-[#0F172A] font-medium">ULIPs</span>
      </nav>
      <span class="text-xs font-semibold uppercase tracking-wider text-[#0D5C46]">Topic Hub</span>
      <h1 class="text-3xl sm:text-4xl font-bold font-serif text-[#0F172A] mt-2">
        Unit-Linked Insurance Plans (ULIPs)
      </h1>
      <p class="text-base text-[#475569] mt-3 max-w-3xl leading-relaxed">
        ULIPs combine market-linked equity and debt investments with life cover inside an insurance wrapper. Explore forensic charge breakdowns, NAV vs investor XIRR analysis, and current tax rules.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {ulipArticles.map((art) => (
        <article class="bg-white border border-[#E5E3D8] rounded-xl p-6 flex flex-col justify-between hover:border-[#0D5C46] transition-colors">
          <div class="space-y-3">
            <span class="text-[11px] font-semibold uppercase px-2 py-0.5 rounded bg-[#E6F3EF] text-[#0D5C46]">
              {art.data.subcategory || 'ULIP Analysis'}
            </span>
            <h2 class="text-lg font-bold font-serif text-[#0F172A] leading-snug">
              <a href={`/cover-and-capital-india/articles/${art.id}/`} class="hover:text-[#0D5C46]">
                {art.data.title}
              </a>
            </h2>
            <p class="text-xs text-[#64748B] leading-relaxed line-clamp-3">
              {art.data.description}
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-[#F1EFEA] flex items-center justify-between text-xs text-[#94A3B8]">
            <span>{art.data.readingTime} min read</span>
            <a href={`/cover-and-capital-india/articles/${art.id}/`} class="text-[#0D5C46] font-semibold hover:underline">
              Read &rarr;
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
