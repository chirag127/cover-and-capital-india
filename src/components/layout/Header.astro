---
import { navigationConfig } from '../../data/navigation';
---

<header class="bg-[#FAF9F5] border-b border-[#E5E3D8] sticky top-0 z-40 backdrop-blur-md bg-opacity-95">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Masthead -->
      <div class="flex flex-col">
        <a href="/cover-and-capital-india/" class="group flex items-baseline gap-2">
          <span class="text-2xl sm:text-3xl font-bold font-serif tracking-tight text-[#0F172A] group-hover:text-[#0D5C46] transition-colors">
            Cover & Capital
          </span>
          <span class="text-xs uppercase tracking-widest font-semibold px-1.5 py-0.5 rounded bg-[#0D5C46] text-white">
            India
          </span>
        </a>
        <span class="text-xs text-[#64748B] hidden sm:inline-block mt-0.5 font-medium">
          Understand Your Cover. Calculate Your Costs. Build Your Wealth.
        </span>
      </div>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center space-x-1" aria-label="Main Navigation">
        {navigationConfig.slice(0, 7).map((item) => (
          <a
            href={item.href}
            class="px-3 py-2 text-sm font-medium text-[#334155] hover:text-[#0D5C46] hover:bg-[#F1EFEA] rounded-md transition-colors"
          >
            {item.title}
          </a>
        ))}
      </nav>

      <!-- Search & Mobile Menu Button -->
      <div class="flex items-center gap-2">
        <a
          href="/cover-and-capital-india/search/"
          class="flex items-center gap-2 px-3 py-1.5 text-xs sm:text-sm font-medium text-[#475569] bg-[#FFFFFF] border border-[#D1CEBE] rounded-full hover:border-[#0D5C46] hover:text-[#0D5C46] transition-colors shadow-2xs"
          aria-label="Search articles and calculators"
        >
          <svg class="w-4 h-4 text-[#64748B]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span class="hidden sm:inline">Search Library</span>
        </a>

        <!-- Mobile Menu Toggle Button -->
        <button
          type="button"
          id="mobile-menu-btn"
          class="lg:hidden p-2 rounded-md text-[#475569] hover:text-[#0F172A] hover:bg-[#F1EFEA] focus:outline-hidden"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-[#E5E3D8] bg-[#FAF9F5] px-4 pt-2 pb-6 space-y-1">
    {navigationConfig.map((item) => (
      <div>
        <a
          href={item.href}
          class="block px-3 py-2 text-base font-medium text-[#0F172A] hover:bg-[#F1EFEA] hover:text-[#0D5C46] rounded-md"
        >
          {item.title}
        </a>
        {item.children && (
          <div class="pl-4 space-y-1 border-l-2 border-[#E5E3D8] ml-3 mt-1">
            {item.children.map((child) => (
              <a
                href={child.href}
                class="block px-3 py-1.5 text-sm text-[#475569] hover:text-[#0D5C46] rounded-md"
              >
                {child.title}
              </a>
            ))}
          </div>
        )}
      </div>
    ))}
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', (!isExpanded).toString());
      menu.classList.toggle('hidden');
    });
  }
</script>
