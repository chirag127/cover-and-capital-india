---
// Nominal vs Real Return Calculator (Fisher Equation)
---

<div class="bg-white border border-[#E5E3D8] rounded-xl p-6 sm:p-8 shadow-xs max-w-3xl mx-auto my-8">
  <div class="border-b border-[#E5E3D8] pb-4 mb-6">
    <div class="flex items-center justify-between flex-wrap gap-2">
      <h3 class="text-xl sm:text-2xl font-bold font-serif text-[#0F172A]">
        Nominal vs Real Return Calculator
      </h3>
      <span class="text-xs uppercase font-semibold px-2 py-0.5 rounded bg-[#E6F3EF] text-[#0D5C46]">
        Fisher Equation Engine
      </span>
    </div>
    <p class="text-sm text-[#64748B] mt-1">
      Calculates your true purchasing-power growth after accounting for inflation using the exact Fisher equation: (1 + r_real) = (1 + r_nominal) / (1 + inflation).
    </p>
  </div>

  <form id="fisher-form" class="space-y-6" onsubmit="return false;">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <div>
        <label for="fisher-nominal" class="block text-xs font-semibold text-[#334155] uppercase tracking-wider mb-1">
          Nominal Stated Return (%)
        </label>
        <input
          type="number"
          id="fisher-nominal"
          class="w-full px-3 py-2 border border-[#CBD5E1] rounded-md focus:ring-2 focus:ring-[#0D5C46] focus:border-[#0D5C46] text-sm"
          value="6.5"
          step="0.1"
          required
        />
        <span class="text-xs text-[#94A3B8]">The return quoted on the brochure or FD</span>
      </div>

      <div>
        <label for="fisher-inflation" class="block text-xs font-semibold text-[#334155] uppercase tracking-wider mb-1">
          Annual Inflation Rate (%)
        </label>
        <input
          type="number"
          id="fisher-inflation"
          class="w-full px-3 py-2 border border-[#CBD5E1] rounded-md focus:ring-2 focus:ring-[#0D5C46] focus:border-[#0D5C46] text-sm"
          value="5.8"
          step="0.1"
          required
        />
        <span class="text-xs text-[#94A3B8]">Expected consumer price inflation</span>
      </div>
    </div>
  </form>

  <!-- Output Display -->
  <div class="mt-8 pt-6 border-t border-[#E5E3D8] space-y-4">
    <div class="bg-[#F8FAFC] border border-[#CBD5E1] rounded-lg p-5">
      <div class="text-xs font-semibold text-[#475569] uppercase tracking-wider">
        Exact Real Annual Return (Purchasing Power Expansion)
      </div>
      <div id="fisher-result-display" class="text-4xl font-bold font-serif text-[#0D5C46] mt-2">
        +0.66%
      </div>
      <p id="fisher-explanation" class="text-xs text-[#475569] mt-2 leading-relaxed">
        While your nominal wealth expands by 6.50%, purchasing power expands by only <strong>0.66% per year</strong>.
      </p>
    </div>

    <div class="bg-[#FAF9F5] border border-[#E5E3D8] rounded-md p-4 text-xs">
      <strong class="text-[#0F172A] block mb-1">Why Simple Subtraction ($6.5\% - 5.8\% = 0.7\%$) Is Imprecise:</strong>
      <p class="text-[#475569]">
        The rule-of-thumb subtraction method ignores the fact that future interest earned is itself received in depreciated currency. The exact Fisher relationship accounts for the compound deflator in the denominator.
      </p>
    </div>
  </div>
</div>

<script>
  function computeFisher() {
    const nominal = parseFloat((document.getElementById('fisher-nominal') as HTMLInputElement)?.value || '6.5') / 100;
    const inflation = parseFloat((document.getElementById('fisher-inflation') as HTMLInputElement)?.value || '5.8') / 100;

    const real = (1 + nominal) / (1 + inflation) - 1;
    const realPct = (real * 100).toFixed(2);

    const display = document.getElementById('fisher-result-display');
    const expl = document.getElementById('fisher-explanation');

    if (display) {
      display.textContent = `${real >= 0 ? '+' : ''}${realPct}%`;
      display.className = real >= 0 ? 'text-4xl font-bold font-serif text-[#0D5C46] mt-2' : 'text-4xl font-bold font-serif text-[#B91C1C] mt-2';
    }

    if (expl) {
      if (real < 0) {
        expl.innerHTML = `⚠️ <strong class="text-rose-700">Negative Real Return:</strong> Your investment is actively losing purchasing power at <strong>${realPct}% per year</strong> despite positive nominal growth.`;
      } else {
        expl.innerHTML = `Your invested capital beats inflation by <strong>${realPct}% per year</strong> in true purchasing power.`;
      }
    }
  }

  document.getElementById('fisher-form')?.addEventListener('input', computeFisher);
  computeFisher();
</script>
