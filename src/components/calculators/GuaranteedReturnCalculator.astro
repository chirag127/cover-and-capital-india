---
// Guaranteed Return & Traditional Policy IRR Calculator
---

<div class="bg-white border border-[#E5E3D8] rounded-xl p-6 sm:p-8 shadow-xs max-w-3xl mx-auto my-8">
  <div class="border-b border-[#E5E3D8] pb-4 mb-6">
    <div class="flex items-center justify-between flex-wrap gap-2">
      <h3 class="text-xl sm:text-2xl font-bold font-serif text-[#0F172A]">
        Guaranteed Policy Return & IRR Analyzer
      </h3>
      <span class="text-xs uppercase font-semibold px-2 py-0.5 rounded bg-[#E6F3EF] text-[#0D5C46]">
        Cash-Flow IRR Engine
      </span>
    </div>
    <p class="text-sm text-[#64748B] mt-1">
      Uncovers the true annualized cash-flow return (IRR) of popular "Guaranteed Income" and endowment plans. Cuts through marketing buzzwords like "Guaranteed 8% Income" or "Double Your Money".
    </p>
  </div>

  <form id="irr-form" class="space-y-6" onsubmit="return false;">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <div>
        <label for="irr-annual-premium" class="block text-xs font-semibold text-[#334155] uppercase tracking-wider mb-1">
          Annual Premium Paid (₹)
        </label>
        <input
          type="number"
          id="irr-annual-premium"
          class="w-full px-3 py-2 border border-[#CBD5E1] rounded-md focus:ring-2 focus:ring-[#0D5C46] focus:border-[#0D5C46] text-sm"
          value="100000"
          min="10000"
          step="10000"
          required
        />
        <span class="text-xs text-[#94A3B8]">Outflow per year including taxes</span>
      </div>

      <div>
        <label for="irr-ppt" class="block text-xs font-semibold text-[#334155] uppercase tracking-wider mb-1">
          Premium Paying Term (Years)
        </label>
        <input
          type="number"
          id="irr-ppt"
          class="w-full px-3 py-2 border border-[#CBD5E1] rounded-md focus:ring-2 focus:ring-[#0D5C46] focus:border-[#0D5C46] text-sm"
          value="10"
          min="1"
          max="30"
          required
        />
        <span class="text-xs text-[#94A3B8]">How many years you pay premiums</span>
      </div>

      <div>
        <label for="irr-deferment" class="block text-xs font-semibold text-[#334155] uppercase tracking-wider mb-1">
          Waiting / Deferment Period (Years)
        </label>
        <input
          type="number"
          id="irr-deferment"
          class="w-full px-3 py-2 border border-[#CBD5E1] rounded-md focus:ring-2 focus:ring-[#0D5C46] focus:border-[#0D5C46] text-sm"
          value="1"
          min="0"
          max="10"
        />
        <span class="text-xs text-[#94A3B8]">Years between last premium and first payout</span>
      </div>

      <div>
        <label for="irr-payout-type" class="block text-xs font-semibold text-[#334155] uppercase tracking-wider mb-1">
          Payout Structure
        </label>
        <select
          id="irr-payout-type"
          class="w-full px-3 py-2 border border-[#CBD5E1] rounded-md focus:ring-2 focus:ring-[#0D5C46] focus:border-[#0D5C46] text-sm bg-white"
        >
          <option value="income">Annual Regular Income + Return of Premium</option>
          <option value="lumpsum">Single Maturity Lump-Sum Payout</option>
        </select>
      </div>

      <div id="income-payout-container">
        <label for="irr-annual-income" class="block text-xs font-semibold text-[#334155] uppercase tracking-wider mb-1">
          Guaranteed Annual Payout Received (₹)
        </label>
        <input
          type="number"
          id="irr-annual-income"
          class="w-full px-3 py-2 border border-[#CBD5E1] rounded-md focus:ring-2 focus:ring-[#0D5C46] focus:border-[#0D5C46] text-sm"
          value="105000"
          min="1000"
          step="5000"
        />
        <span class="text-xs text-[#94A3B8]">Received each year during payout period</span>
      </div>

      <div id="payout-years-container">
        <label for="irr-payout-years" class="block text-xs font-semibold text-[#334155] uppercase tracking-wider mb-1">
          Payout Duration (Years)
        </label>
        <input
          type="number"
          id="irr-payout-years"
          class="w-full px-3 py-2 border border-[#CBD5E1] rounded-md focus:ring-2 focus:ring-[#0D5C46] focus:border-[#0D5C46] text-sm"
          value="25"
          min="1"
          max="40"
        />
        <span class="text-xs text-[#94A3B8]">Total years income is guaranteed</span>
      </div>

      <div id="terminal-rop-container" class="sm:col-span-2">
        <label for="irr-terminal-rop" class="block text-xs font-semibold text-[#334155] uppercase tracking-wider mb-1">
          Terminal Payout at End of Policy (₹)
        </label>
        <input
          type="number"
          id="irr-terminal-rop"
          class="w-full px-3 py-2 border border-[#CBD5E1] rounded-md focus:ring-2 focus:ring-[#0D5C46] focus:border-[#0D5C46] text-sm"
          value="1000000"
          min="0"
          step="50000"
        />
        <span class="text-xs text-[#94A3B8]">Usually 100% Return of Premium (ROP) at end of payout period</span>
      </div>
    </div>
  </form>

  <!-- Output Display -->
  <div class="mt-8 pt-6 border-t border-[#E5E3D8] space-y-4">
    <div class="bg-[#F8FAFC] border border-[#CBD5E1] rounded-lg p-5">
      <div class="flex items-baseline justify-between flex-wrap gap-2">
        <span class="text-xs font-semibold text-[#475569] uppercase tracking-wider">
          Actual Cash-Flow Internal Rate of Return (IRR)
        </span>
        <span id="irr-benchmark-badge" class="text-xs font-medium px-2 py-0.5 rounded bg-amber-100 text-amber-800">
          Below Sovereign Benchmarks
        </span>
      </div>
      <div id="irr-result-display" class="text-4xl font-bold font-serif text-[#0F172A] mt-2">
        5.78%
      </div>
      <p id="irr-explanation-text" class="text-xs text-[#475569] mt-2 leading-relaxed">
        While the brochure advertises "Guaranteed 10.5% Payout of Annual Premium", the true financial return on your invested capital is only <strong>5.78% per year</strong> due to the long lock-in and deferred timing of cash flows.
      </p>
    </div>

    <!-- Comparative Benchmarks Table -->
    <div class="bg-white border border-[#E5E3D8] rounded-md p-4 text-xs space-y-2">
      <div class="font-semibold text-[#0F172A] mb-2 uppercase tracking-wider">Contextual Benchmark Comparison (FY 2026–27):</div>
      <div class="flex justify-between py-1 border-b border-[#F1EFEA]">
        <span>Public Provident Fund (PPF) — Sovereign EEE:</span>
        <strong class="text-emerald-700">7.10% (100% Tax-Free)</strong>
      </div>
      <div class="flex justify-between py-1 border-b border-[#F1EFEA]">
        <span>RBI Retail Direct 10-Year Government of India Bond (G-Sec):</span>
        <strong>~7.00%–7.20%</strong>
      </div>
      <div class="flex justify-between py-1">
        <span>Average Long-Term Indian CPI Inflation Drag:</span>
        <strong class="text-rose-700">~5.50%–6.00%</strong>
      </div>
    </div>
  </div>

  <div class="mt-4 text-xs text-[#64748B] italic">
    * Mathematical Engine: Uses the Newton-Raphson polynomial solver to find the exact root of Net Present Value: NPV(r) = sum( CF_t / (1+r)^t ) = 0.
  </div>
</div>

<script>
  function calculateNewtonIRR(cashFlows: number[]): number | null {
    if (!cashFlows || cashFlows.length < 2) return null;
    let rate = 0.06;
    for (let iter = 0; iter < 100; iter++) {
      let npv = 0;
      let dNpv = 0;
      for (let t = 0; t < cashFlows.length; t++) {
        const cf = cashFlows[t];
        const denom = Math.pow(1 + rate, t);
        npv += cf / denom;
        if (t > 0) dNpv -= (t * cf) / Math.pow(1 + rate, t + 1);
      }
      if (Math.abs(npv) < 1e-7) return rate;
      if (Math.abs(dNpv) < 1e-12) {
        rate += 0.05;
        continue;
      }
      const nextRate = rate - npv / dNpv;
      if (Math.abs(nextRate - rate) < 1e-7) return nextRate;
      rate = nextRate;
    }
    return null;
  }

  function runIRRCalculation() {
    const premium = parseFloat((document.getElementById('irr-annual-premium') as HTMLInputElement)?.value || '100000');
    const ppt = parseInt((document.getElementById('irr-ppt') as HTMLInputElement)?.value || '10', 10);
    const deferment = parseInt((document.getElementById('irr-deferment') as HTMLInputElement)?.value || '1', 10);
    const payoutType = (document.getElementById('irr-payout-type') as HTMLSelectElement)?.value || 'income';

    const incomeContainer = document.getElementById('income-payout-container');
    const yearsContainer = document.getElementById('payout-years-container');

    let cashFlows: number[] = [];

    if (payoutType === 'income') {
      if (incomeContainer) incomeContainer.style.display = 'block';
      if (yearsContainer) yearsContainer.style.display = 'block';

      const income = parseFloat((document.getElementById('irr-annual-income') as HTMLInputElement)?.value || '105000');
      const payoutYears = parseInt((document.getElementById('irr-payout-years') as HTMLInputElement)?.value || '25', 10);
      const terminalRop = parseFloat((document.getElementById('irr-terminal-rop') as HTMLInputElement)?.value || '1000000');

      const totalYears = ppt + deferment + payoutYears;
      cashFlows = new Array(totalYears + 1).fill(0);

      // Outflows
      for (let t = 0; t < ppt; t++) {
        cashFlows[t] = -premium;
      }

      // Inflows
      const startPayout = ppt + deferment;
      for (let t = startPayout; t < totalYears; t++) {
        cashFlows[t] = income;
      }
      // Last year gets income + terminal ROP
      cashFlows[totalYears] = income + terminalRop;
    } else {
      if (incomeContainer) incomeContainer.style.display = 'none';
      if (yearsContainer) yearsContainer.style.display = 'none';

      const lumpsum = parseFloat((document.getElementById('irr-terminal-rop') as HTMLInputElement)?.value || '2500000');
      const totalYears = ppt + deferment;
      cashFlows = new Array(totalYears + 1).fill(0);

      for (let t = 0; t < ppt; t++) {
        cashFlows[t] = -premium;
      }
      cashFlows[totalYears] = lumpsum;
    }

    const rate = calculateNewtonIRR(cashFlows);
    const display = document.getElementById('irr-result-display');
    const badge = document.getElementById('irr-benchmark-badge');
    const expl = document.getElementById('irr-explanation-text');

    if (display) {
      if (rate !== null && !isNaN(rate)) {
        const pct = (rate * 100).toFixed(2);
        display.textContent = `${pct}%`;

        if (rate < 0.06) {
          if (badge) {
            badge.className = 'text-xs font-medium px-2 py-0.5 rounded bg-rose-100 text-rose-800';
            badge.textContent = 'Losing to Inflation (~6%)';
          }
        } else if (rate < 0.071) {
          if (badge) {
            badge.className = 'text-xs font-medium px-2 py-0.5 rounded bg-amber-100 text-amber-800';
            badge.textContent = 'Below Sovereign PPF (7.1%)';
          }
        } else {
          if (badge) {
            badge.className = 'text-xs font-medium px-2 py-0.5 rounded bg-emerald-100 text-emerald-800';
            badge.textContent = 'Competitive Yield';
          }
        }

        if (expl) {
          expl.innerHTML = `Your invested capital generates a true net annual cash-flow return of <strong>${pct}%</strong>. Traditional insurance products lock up money for decades at yields barely matching or lagging inflation.`;
        }
      } else {
        display.textContent = 'Non-convergent';
      }
    }
  }

  document.getElementById('irr-form')?.addEventListener('input', runIRRCalculation);
  document.getElementById('irr-payout-type')?.addEventListener('change', runIRRCalculation);
  runIRRCalculation();
</script>
