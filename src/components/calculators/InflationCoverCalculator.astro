---
// Inflation-Adjusted Cover Calculator
---

<div class="bg-white border border-[#E5E3D8] rounded-xl p-6 sm:p-8 shadow-xs max-w-3xl mx-auto my-8">
  <div class="border-b border-[#E5E3D8] pb-4 mb-6">
    <div class="flex items-center justify-between flex-wrap gap-2">
      <h3 class="text-xl sm:text-2xl font-bold font-serif text-[#0F172A]">
        Inflation-Adjusted Cover Calculator
      </h3>
      <span class="text-xs uppercase font-semibold px-2 py-0.5 rounded bg-[#FEF2F2] text-[#991B1B]">
        Purchasing Power Erosion
      </span>
    </div>
    <p class="text-sm text-[#64748B] mt-1">
      Visualizes how consumer price inflation erodes the real purchasing power of fixed life insurance death benefits over a 20 to 30-year policy horizon.
    </p>
  </div>

  <form id="inflation-form" class="space-y-6" onsubmit="return false;">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
      <div>
        <label for="inf-sum-assured" class="block text-xs font-semibold text-[#334155] uppercase tracking-wider mb-1">
          Nominal Sum Assured (₹)
        </label>
        <input
          type="number"
          id="inf-sum-assured"
          class="w-full px-3 py-2 border border-[#CBD5E1] rounded-md focus:ring-2 focus:ring-[#0D5C46] focus:border-[#0D5C46] text-sm"
          value="10000000"
          min="1000000"
          step="500000"
          required
        />
        <span class="text-xs text-[#94A3B8]">Policy face value (e.g. ₹1 Crore)</span>
      </div>

      <div>
        <label for="inf-rate" class="block text-xs font-semibold text-[#334155] uppercase tracking-wider mb-1">
          Assumed Annual Inflation (%)
        </label>
        <input
          type="number"
          id="inf-rate"
          class="w-full px-3 py-2 border border-[#CBD5E1] rounded-md focus:ring-2 focus:ring-[#0D5C46] focus:border-[#0D5C46] text-sm"
          value="6.0"
          min="2"
          max="12"
          step="0.5"
          required
        />
        <span class="text-xs text-[#94A3B8]">Historical Indian CPI average</span>
      </div>

      <div>
        <label for="inf-years" class="block text-xs font-semibold text-[#334155] uppercase tracking-wider mb-1">
          Years Into the Future
        </label>
        <input
          type="number"
          id="inf-years"
          class="w-full px-3 py-2 border border-[#CBD5E1] rounded-md focus:ring-2 focus:ring-[#0D5C46] focus:border-[#0D5C46] text-sm"
          value="25"
          min="1"
          max="40"
          required
        />
        <span class="text-xs text-[#94A3B8]">Time of potential claim</span>
      </div>
    </div>
  </form>

  <!-- Output Results -->
  <div class="mt-8 pt-6 border-t border-[#E5E3D8] space-y-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="bg-[#FEF2F2] border border-[#FECACA] rounded-lg p-5">
        <span class="text-xs font-semibold text-[#991B1B] uppercase tracking-wider">
          Real Purchasing Power in Today's Money
        </span>
        <div id="inf-real-power-display" class="text-3xl font-bold font-serif text-[#991B1B] mt-2">
          ₹23.30 Lakh
        </div>
        <p class="text-xs text-[#991B1B] mt-2">
          Loses <strong id="inf-loss-pct">76.7%</strong> of its economic purchasing power due to compounding inflation.
        </p>
      </div>

      <div class="bg-[#F0FDF4] border border-[#BBF7D0] rounded-lg p-5">
        <span class="text-xs font-semibold text-[#166534] uppercase tracking-wider">
          Nominal Cover Needed in Future to Equal ₹1 Cr Today
        </span>
        <div id="inf-needed-display" class="text-3xl font-bold font-serif text-[#0D5C46] mt-2">
          ₹4.29 Crore
        </div>
        <p class="text-xs text-[#166534] mt-2">
          To buy what ₹1 Crore buys today, a claim in year <span id="inf-year-text">25</span> would require this sum.
        </p>
      </div>
    </div>

    <!-- Multi-Year Horizon Table -->
    <div class="overflow-x-auto text-xs">
      <table class="w-full border-collapse">
        <thead>
          <tr class="bg-[#F1EFEA]">
            <th class="p-2 text-left font-semibold border border-[#D1CEBE]">Milestone</th>
            <th class="p-2 text-right font-semibold border border-[#D1CEBE]">Nominal Value</th>
            <th class="p-2 text-right font-semibold border border-[#D1CEBE]">Real Value (Today's ₹)</th>
            <th class="p-2 text-right font-semibold border border-[#D1CEBE]">Purchasing Power Retained</th>
          </tr>
        </thead>
        <tbody id="inf-table-body">
          <!-- Populated by JS -->
        </tbody>
      </table>
    </div>
  </div>

  <div class="mt-4 text-xs text-[#64748B] italic">
    * Strategic Insight: This erosion is why financial planners recommend reviewing term life cover at major life milestones (e.g. childbirth, home purchase) or choosing an increasing term cover structure.
  </div>
</div>

<script>
  function formatINRCompact(num: number): string {
    const abs = Math.abs(num);
    const isNeg = num < 0;
    if (abs >= 10000000) return `${isNeg ? '-' : ''}₹${(abs / 10000000).toFixed(2)} Crore`;
    if (abs >= 100000) return `${isNeg ? '-' : ''}₹${(abs / 100000).toFixed(2)} Lakh`;
    return `${isNeg ? '-' : ''}₹${Math.round(abs).toLocaleString('en-IN')}`;
  }

  function updateInflationCalculations() {
    const sumAssured = parseFloat((document.getElementById('inf-sum-assured') as HTMLInputElement)?.value || '10000000');
    const infRate = parseFloat((document.getElementById('inf-rate') as HTMLInputElement)?.value || '6.0') / 100;
    const years = parseInt((document.getElementById('inf-years') as HTMLInputElement)?.value || '25', 10);

    const realPower = sumAssured / Math.pow(1 + infRate, years);
    const neededFuture = sumAssured * Math.pow(1 + infRate, years);
    const lossPct = ((1 - realPower / sumAssured) * 100).toFixed(1);

    const realDisplay = document.getElementById('inf-real-power-display');
    const lossDisplay = document.getElementById('inf-loss-pct');
    const neededDisplay = document.getElementById('inf-needed-display');
    const yearText = document.getElementById('inf-year-text');

    if (realDisplay) realDisplay.textContent = formatINRCompact(realPower);
    if (lossDisplay) lossDisplay.textContent = `${lossPct}%`;
    if (neededDisplay) neededDisplay.textContent = formatINRCompact(neededFuture);
    if (yearText) yearText.textContent = years.toString();

    // Populate Table for 5, 10, 15, 20, 25, 30 years
    const tableBody = document.getElementById('inf-table-body');
    if (tableBody) {
      const milestones = [5, 10, 15, 20, 25, 30];
      let rows = '';
      milestones.forEach((m) => {
        const val = sumAssured / Math.pow(1 + infRate, m);
        const retained = ((val / sumAssured) * 100).toFixed(1);
        rows += `
          <tr class="border-b border-[#E5E3D8]">
            <td class="p-2 border border-[#E5E3D8] font-medium">After ${m} Years</td>
            <td class="p-2 border border-[#E5E3D8] text-right">${formatINRCompact(sumAssured)}</td>
            <td class="p-2 border border-[#E5E3D8] text-right font-semibold text-[#991B1B]">${formatINRCompact(val)}</td>
            <td class="p-2 border border-[#E5E3D8] text-right">${retained}%</td>
          </tr>
        `;
      });
      tableBody.innerHTML = rows;
    }
  }

  document.getElementById('inflation-form')?.addEventListener('input', updateInflationCalculations);
  updateInflationCalculations();
</script>
