---
// Life Cover Estimator Component
---

<div class="bg-white border border-[#E5E3D8] rounded-xl p-6 sm:p-8 shadow-xs max-w-3xl mx-auto my-8">
  <div class="border-b border-[#E5E3D8] pb-4 mb-6">
    <div class="flex items-center justify-between flex-wrap gap-2">
      <h3 class="text-xl sm:text-2xl font-bold font-serif text-[#0F172A]">
        Life Cover Need Estimator
      </h3>
      <span class="text-xs uppercase font-semibold px-2 py-0.5 rounded bg-[#E6F3EF] text-[#0D5C46]">
        Expense + Liability Model
      </span>
    </div>
    <p class="text-sm text-[#64748B] mt-1">
      Calculates the required term insurance sum assured based on household living expenses, outstanding debts, and future family obligations without double-counting existing assets.
    </p>
  </div>

  <form id="cover-form" class="space-y-6" onsubmit="return false;">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <div>
        <label for="annual-expenses" class="block text-xs font-semibold text-[#334155] uppercase tracking-wider mb-1">
          Annual Household Expenses (₹)
        </label>
        <input
          type="number"
          id="annual-expenses"
          class="w-full px-3 py-2 border border-[#CBD5E1] rounded-md focus:ring-2 focus:ring-[#0D5C46] focus:border-[#0D5C46] text-sm"
          value="600000"
          min="50000"
          step="25000"
          required
        />
        <span class="text-xs text-[#94A3B8]">Excluding personal loans and EMIs</span>
      </div>

      <div>
        <label for="replacement-years" class="block text-xs font-semibold text-[#334155] uppercase tracking-wider mb-1">
          Years of Expense Replacement
        </label>
        <input
          type="number"
          id="replacement-years"
          class="w-full px-3 py-2 border border-[#CBD5E1] rounded-md focus:ring-2 focus:ring-[#0D5C46] focus:border-[#0D5C46] text-sm"
          value="20"
          min="1"
          max="40"
          required
        />
        <span class="text-xs text-[#94A3B8]">Until dependants reach financial independence</span>
      </div>

      <div>
        <label for="outstanding-debts" class="block text-xs font-semibold text-[#334155] uppercase tracking-wider mb-1">
          Total Outstanding Debts (₹)
        </label>
        <input
          type="number"
          id="outstanding-debts"
          class="w-full px-3 py-2 border border-[#CBD5E1] rounded-md focus:ring-2 focus:ring-[#0D5C46] focus:border-[#0D5C46] text-sm"
          value="3500000"
          min="0"
          step="50000"
        />
        <span class="text-xs text-[#94A3B8]">Home loan, car loan, personal liabilities</span>
      </div>

      <div>
        <label for="future-goals" class="block text-xs font-semibold text-[#334155] uppercase tracking-wider mb-1">
          Major Future Goals (₹)
        </label>
        <input
          type="number"
          id="future-goals"
          class="w-full px-3 py-2 border border-[#CBD5E1] rounded-md focus:ring-2 focus:ring-[#0D5C46] focus:border-[#0D5C46] text-sm"
          value="2500000"
          min="0"
          step="50000"
        />
        <span class="text-xs text-[#94A3B8]">Children's education, healthcare contingency</span>
      </div>

      <div>
        <label for="liquid-assets" class="block text-xs font-semibold text-[#334155] uppercase tracking-wider mb-1">
          Existing Liquid Assets (₹)
        </label>
        <input
          type="number"
          id="liquid-assets"
          class="w-full px-3 py-2 border border-[#CBD5E1] rounded-md focus:ring-2 focus:ring-[#0D5C46] focus:border-[#0D5C46] text-sm"
          value="1500000"
          min="0"
          step="50000"
        />
        <span class="text-xs text-[#94A3B8]">Mutual funds, fixed deposits, accessible PF</span>
      </div>

      <div>
        <label for="existing-cover" class="block text-xs font-semibold text-[#334155] uppercase tracking-wider mb-1">
          Existing Active Term Cover (₹)
        </label>
        <input
          type="number"
          id="existing-cover"
          class="w-full px-3 py-2 border border-[#CBD5E1] rounded-md focus:ring-2 focus:ring-[#0D5C46] focus:border-[#0D5C46] text-sm"
          value="0"
          min="0"
          step="500000"
        />
        <span class="text-xs text-[#94A3B8]">Valid individual term policies already active</span>
      </div>
    </div>

    <!-- Assumptions Accordion -->
    <div class="bg-[#FAF9F5] p-3 rounded-md text-xs text-[#475569] flex justify-between items-center border border-[#E5E3D8]">
      <span>Assumed Inflation: <strong>6.0%</strong> | Assumed Post-Tax Safe Yield: <strong>7.0%</strong> (Net Real Discount Rate: <strong>0.94%</strong>)</span>
      <button type="button" id="recalc-btn" class="px-3 py-1 bg-[#0D5C46] text-white rounded text-xs font-medium hover:bg-[#083E2F]">
        Calculate Cover
      </button>
    </div>
  </form>

  <!-- Output Display -->
  <div id="cover-results" class="mt-8 pt-6 border-t border-[#E5E3D8] space-y-4">
    <div class="bg-[#F0FDF4] border border-[#BBF7D0] rounded-lg p-5">
      <div class="text-xs font-semibold text-[#166534] uppercase tracking-wider mb-1">
        Recommended Additional Term Cover
      </div>
      <div id="net-cover-display" class="text-3xl sm:text-4xl font-bold font-serif text-[#0D5C46]">
        ₹1.55 Crore
      </div>
      <div class="text-xs text-[#166534] mt-2">
        This protection ensures your dependants can replace income, eliminate debt, and fund goals without selling their family residence.
      </div>
    </div>

    <!-- Breakdown Table -->
    <div class="overflow-x-auto text-xs">
      <table class="w-full border-collapse">
        <tbody>
          <tr class="border-b border-[#E5E3D8]">
            <td class="py-2 text-[#475569]">Household Living Expenses Fund (PV):</td>
            <td id="table-expense-fund" class="py-2 text-right font-semibold text-[#0F172A]">₹1,09,58,000</td>
          </tr>
          <tr class="border-b border-[#E5E3D8]">
            <td class="py-2 text-[#475569]">Outstanding Liabilities (Debt Clearance):</td>
            <td id="table-debts" class="py-2 text-right font-semibold text-[#0F172A]">+ ₹35,00,000</td>
          </tr>
          <tr class="border-b border-[#E5E3D8]">
            <td class="py-2 text-[#475569]">Future Major Family Goals:</td>
            <td id="table-goals" class="py-2 text-right font-semibold text-[#0F172A]">+ ₹25,00,000</td>
          </tr>
          <tr class="border-b border-[#E5E3D8] bg-[#FAF9F5]">
            <td class="py-2 font-semibold text-[#0F172A]">Gross Protection Capital Needed:</td>
            <td id="table-gross" class="py-2 text-right font-bold text-[#0F172A]">₹1,69,58,000</td>
          </tr>
          <tr class="border-b border-[#E5E3D8] text-[#166534]">
            <td class="py-2">Less: Current Liquid Assets Available:</td>
            <td id="table-assets" class="py-2 text-right font-semibold">- ₹15,00,000</td>
          </tr>
          <tr class="border-b border-[#E5E3D8] text-[#166534]">
            <td class="py-2">Less: Existing Individual Term Cover:</td>
            <td id="table-existing-cover" class="py-2 text-right font-semibold">- ₹0</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="mt-6 text-xs text-[#64748B] italic">
    * Methodology: Uses the present value of an inflation-indexed annuity due. This is a mathematical planning framework and does not constitute underwriter medical acceptance or an insurance recommendation.
  </div>
</div>

<script>
  function formatIndianRupees(amount: number, compact: boolean = false): string {
    const abs = Math.abs(amount);
    const isNeg = amount < 0;
    if (compact) {
      if (abs >= 10000000) return `${isNeg ? '-' : ''}₹${(abs / 10000000).toFixed(2)} Crore`;
      if (abs >= 100000) return `${isNeg ? '-' : ''}₹${(abs / 100000).toFixed(2)} Lakh`;
    }
    const rounded = Math.round(abs);
    const s = rounded.toString();
    if (s.length > 3) {
      const last3 = s.substring(s.length - 3);
      const rest = s.substring(0, s.length - 3);
      const withCommas = rest.replace(/\B(?=(\d{2})+(?!\d))/g, ',');
      return `${isNeg ? '-' : ''}₹${withCommas},${last3}`;
    }
    return `${isNeg ? '-' : ''}₹${s}`;
  }

  function computeCover() {
    const expenses = parseFloat((document.getElementById('annual-expenses') as HTMLInputElement)?.value || '0');
    const years = parseFloat((document.getElementById('replacement-years') as HTMLInputElement)?.value || '20');
    const debts = parseFloat((document.getElementById('outstanding-debts') as HTMLInputElement)?.value || '0');
    const goals = parseFloat((document.getElementById('future-goals') as HTMLInputElement)?.value || '0');
    const assets = parseFloat((document.getElementById('liquid-assets') as HTMLInputElement)?.value || '0');
    const existing = parseFloat((document.getElementById('existing-cover') as HTMLInputElement)?.value || '0');

    const inflation = 0.06;
    const returnRate = 0.07;
    const realDiscount = (1 + returnRate) / (1 + inflation) - 1;

    let expenseFund = 0;
    if (Math.abs(realDiscount) < 1e-4) {
      expenseFund = expenses * years;
    } else {
      expenseFund = expenses * ((1 - Math.pow(1 + realDiscount, -years)) / realDiscount);
    }

    const gross = expenseFund + debts + goals;
    const net = Math.max(0, gross - assets - existing);

    const netDisplay = document.getElementById('net-cover-display');
    const tableExpense = document.getElementById('table-expense-fund');
    const tableDebts = document.getElementById('table-debts');
    const tableGoals = document.getElementById('table-goals');
    const tableGross = document.getElementById('table-gross');
    const tableAssets = document.getElementById('table-assets');
    const tableExisting = document.getElementById('table-existing-cover');

    if (netDisplay) netDisplay.textContent = formatIndianRupees(net, true);
    if (tableExpense) tableExpense.textContent = formatIndianRupees(expenseFund);
    if (tableDebts) tableDebts.textContent = `+ ${formatIndianRupees(debts)}`;
    if (tableGoals) tableGoals.textContent = `+ ${formatIndianRupees(goals)}`;
    if (tableGross) tableGross.textContent = formatIndianRupees(gross);
    if (tableAssets) tableAssets.textContent = `- ${formatIndianRupees(assets)}`;
    if (tableExisting) tableExisting.textContent = `- ${formatIndianRupees(existing)}`;
  }

  document.getElementById('cover-form')?.addEventListener('input', computeCover);
  document.getElementById('recalc-btn')?.addEventListener('click', computeCover);
  computeCover();
</script>
