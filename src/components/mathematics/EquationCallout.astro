---
interface Props {
  title: string;
  formula: string; // KaTeX format (e.g. "r_{\\text{real}} = \\frac{1 + r_{\\text{nominal}}}{1 + \\pi} - 1")
  variables: Array<{ symbol: string; explanation: string }>;
  assumptions?: string[];
  implication?: string;
}

const { title, formula, variables, assumptions, implication } = Astro.props;
---

<div class="my-8 bg-[#FAF9F5] border border-[#D1CEBE] rounded-xl p-5 sm:p-6 shadow-2xs">
  <div class="flex items-center justify-between border-b border-[#E5E3D8] pb-3 mb-4">
    <h4 class="text-sm font-bold font-serif text-[#0F172A] tracking-tight">{title}</h4>
    <span class="text-xs uppercase font-semibold px-2 py-0.5 rounded bg-[#E6F3EF] text-[#0D5C46]">
      Mathematical Formulation
    </span>
  </div>

  <!-- Equation Display (server/client math) -->
  <div class="bg-white border border-[#E5E3D8] rounded-lg p-4 my-3 text-center overflow-x-auto">
    <div class="text-lg sm:text-xl font-serif text-[#0F172A] py-1">
      $${formula}$$
    </div>
  </div>

  <!-- Variable Definitions -->
  <div class="mt-4 pt-2">
    <h5 class="text-xs font-semibold uppercase tracking-wider text-[#64748B] mb-2">Defined Parameters:</h5>
    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
      {variables.map((v) => (
        <li class="flex items-baseline gap-2 bg-[#F4F3EE] p-2 rounded">
          <code class="font-mono font-semibold text-[#0D5C46]">{v.symbol}</code>
          <span class="text-[#475569]">{v.explanation}</span>
        </li>
      ))}
    </ul>
  </div>

  {assumptions && assumptions.length > 0 && (
    <div class="mt-4 pt-3 border-t border-[#E5E3D8] text-xs text-[#64748B]">
      <strong class="text-[#334155]">Explicit Assumptions:</strong>
      <ul class="list-disc pl-4 mt-1 space-y-0.5">
        {assumptions.map((a) => (
          <li>{a}</li>
        ))}
      </ul>
    </div>
  )}

  {implication && (
    <div class="mt-3 text-xs bg-[#E6F3EF] border-l-2 border-[#0D5C46] p-2.5 rounded-r text-[#0D5C46]">
      <strong>Financial Implication:</strong> {implication}
    </div>
  )}
</div>
